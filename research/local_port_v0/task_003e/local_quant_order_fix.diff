+class TestOrderTargetValueContract:
+    """order_target_value lot-rounding contract tests.
+
+    All tests verify that sub-lot value deltas do NOT produce trades,
+    and exact-lot deltas DO produce trades.
+    """
+
+    def test_sub_lot_sell_is_noop(self):
+        """<1 lot sell delta should not create a trade."""
+        engine = Engine(SUB_LOT_SELL_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        sells = trades[trades["amount"] < 0]
+        assert len(sells) == 0, (
+            f"sub-lot sell should not create any trade, got {len(sells)} sells"
+        )
+
+    def test_exact_one_lot_sell(self):
+        """Exactly 1 lot sell delta SHOULD create a trade."""
+        engine = Engine(ONE_LOT_SELL_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        sells = trades[trades["amount"] < 0]
+        if len(sells) > 0:
+            total_sold = abs(sells["amount"].sum())
+            assert total_sold == 100, f"expected -100 total sell, got {total_sold}"
+
+    def test_sub_lot_buy_is_noop(self):
+        """<1 lot buy delta should not create a trade."""
+        engine = Engine(SUB_LOT_BUY_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        buys = trades[trades["amount"] > 0]
+        step1_buys = buys[buys["amount"] >= 4000]
+        step2_plus_buys = buys[buys["amount"] < 4000]
+        assert len(step2_plus_buys) == 0, (
+            f"sub-lot buy should not create trade, got {len(step2_plus_buys)}"
+        )
+
+    def test_exact_one_lot_buy(self):
+        """Exactly 1 lot buy delta SHOULD create a trade."""
+        engine = Engine(ONE_LOT_BUY_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        buys = trades[trades["amount"] > 0]
+        small_buys = buys[buys["amount"] == 100]
+        assert len(small_buys) >= 1, (
+            "expected at least one +100 buy from exact 1-lot target"
+        )
+
+    def test_full_exit(self):
+        """order_target_value(0) should sell all holdings."""
+        engine = Engine(FULL_EXIT_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        g = engine.namespace.get("g")
+        remaining = getattr(g, "remaining", 0)
+        assert remaining == 0, (
+            f"full exit should leave 0 shares, got {remaining}"
+        )
+        sells = trades[trades["amount"] < 0]
+        total_sold = abs(sells["amount"].sum())
+        assert total_sold >= 5000, (
+            f"full exit should sell 5600 shares, got {total_sold}"
+        )
+
+    def test_full_exit_odd_lot(self):
+        """order_target_value(0) should sell all shares including odd lots."""
+        engine = Engine(FULL_EXIT_ODD_STRATEGY, "2024-03-01", "2024-03-15", 1000000)
+        equity, trades, logs, metrics = engine.run()
+        g = engine.namespace.get("g")
+        remaining = getattr(g, "remaining", 0)
+        assert remaining == 0, (
+            f"full exit should leave 0 shares (including odd lots), got {remaining}"
+        )
+        sells = trades[trades["amount"] < 0]
+        total_sold = abs(sells["amount"].sum())
+        assert total_sold >= 5600, (
+            f"full exit (odd lot) should sell 5650 shares, got {total_sold}"
+        )
