         inst_type = self._get_instrument_type(security)
         if inst_type == 'bond':
-            target_amount = int(value / price / 10) * 10
+            lot_size = 10
         elif inst_type in ('stock', 'etf'):
-            target_amount = int(value / price / 100) * 100
+            lot_size = 100
         else:
-            target_amount = int(value / price)
+            lot_size = 1
+
+        position = self.context.portfolio.positions.get(security)
+        current_amount = position.total_amount if position else 0
+
+        if value == 0:
+            target_amount = 0
+        else:
+            # Use the position reference price for delta calculation to stay
+            # consistent with the strategy's own valuation. The strategy
+            # computes target_value based on pos.price; using a different
+            # price (curr_price) would introduce phantom deltas.
+            ref_price = price
+            if position is not None:
+                ref_price = position.price
+
+            current_value = current_amount * ref_price
+            delta_value = value - current_value
+            # truncate_toward_zero: floor for positive, -floor(abs) for negative
+            raw_lots = delta_value / ref_price / lot_size
+            if delta_value >= 0:
+                delta_amount = int(raw_lots) * lot_size
+            else:
+                delta_amount = -int(abs(raw_lots)) * lot_size
+            target_amount = current_amount + delta_amount
 
         return self.order_target(security, target_amount, style)
 
